# Azure Configuration
AZURE_SUBSCRIPTION_ID=your_subscription_id
AZURE_RESOURCE_GROUP=AquaGuard-RG
AZURE_WORKSPACE_NAME=AquaGuard-ML-Workspace
AZURE_LOCATION=eastus2

# Azure Cognitive Services
AZURE_COMPUTER_VISION_ENDPOINT=https://your-vision-endpoint.cognitiveservices.azure.com/
AZURE_COMPUTER_VISION_KEY=your_vision_key

# Azure Maps
AZURE_MAPS_SUBSCRIPTION_KEY=your_maps_key

# Azure Event Hub / IoT Hub
AZURE_EVENT_HUB_CONNECTION_STRING=your_event_hub_connection_string
AZURE_EVENT_HUB_NAME=aquaguard-events

# Azure OpenAI (optional)
AZURE_OPENAI_ENDPOINT=https://your-openai-endpoint.openai.azure.com/
AZURE_OPENAI_KEY=your_openai_key
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4

# Simulation Settings
SIMULATION_MODE=true
DATA_GENERATION_INTERVAL=60  # seconds
ALERT_THRESHOLD_FLOOD=70
ALERT_THRESHOLD_SHIP_ANOMALY=0.8
ALERT_THRESHOLD_SPILL_CONFIDENCE=0.7

# Power BI Configuration
POWER BI_REFRESH_INTERVAL=300  # seconds
DATA_EXPORT_PATH=./data/outputs
