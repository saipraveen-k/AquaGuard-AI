{
  "flood_predictions": {
    "description": "Flood risk prediction results from Azure ML model",
    "columns": [
      {
        "name": "timestamp",
        "type": "datetime",
        "description": "Prediction timestamp",
        "example": "2024-01-15T10:30:00"
      },
      {
        "name": "location_id",
        "type": "string",
        "description": "Unique location identifier",
        "example": "LOC001"
      },
      {
        "name": "location_name",
        "type": "string",
        "description": "Human-readable location name",
        "example": "River Delta Station"
      },
      {
        "name": "latitude",
        "type": "float",
        "description": "Location latitude",
        "example": "40.7128"
      },
      {
        "name": "longitude",
        "type": "float",
        "description": "Location longitude",
        "example": "-74.0060"
      },
      {
        "name": "rainfall_mm_per_hour",
        "type": "float",
        "description": "Current rainfall rate",
        "example": "25.5"
      },
      {
        "name": "river_level_meters",
        "type": "float",
        "description": "River water level",
        "example": "6.2"
      },
      {
        "name": "soil_moisture_percent",
        "type": "float",
        "description": "Soil moisture content",
        "example": "78.5"
      },
      {
        "name": "risk_percentage",
        "type": "float",
        "description": "Flood risk probability (0-100)",
        "example": "85.2"
      },
      {
        "name": "risk_level",
        "type": "string",
        "description": "Risk categorization",
        "example": "High"
      },
      {
        "name": "time_to_flood_hours",
        "type": "float",
        "description": "Estimated time to flooding",
        "example": "4.5"
      },
      {
        "name": "confidence_score",
        "type": "float",
        "description": "Model confidence (0-1)",
        "example": "0.923"
      }
    ]
  },
  "ship_emergencies": {
    "description": "Ship emergency detection results from AIS analysis",
    "columns": [
      {
        "name": "timestamp",
        "type": "datetime",
        "description": "Detection timestamp",
        "example": "2024-01-15T10:30:00"
      },
      {
        "name": "mmsi",
        "type": "string",
        "description": "Maritime Mobile Service Identity",
        "example": "000000001"
      },
      {
        "name": "ship_name",
        "type": "string",
        "description": "Vessel name",
        "example": "Cargo Voyager"
      },
      {
        "name": "ship_type",
        "type": "string",
        "description": "Vessel category",
        "example": "cargo"
      },
      {
        "name": "latitude",
        "type": "float",
        "description": "Current latitude",
        "example": "40.7128"
      },
      {
        "name": "longitude",
        "type": "float",
        "description": "Current longitude",
        "example": "-74.0060"
      },
      {
        "name": "speed_knots",
        "type": "float",
        "description": "Current speed",
        "example": "12.5"
      },
      {
        "name": "heading_degrees",
        "type": "float",
        "description": "Course heading",
        "example": "045.0"
      },
      {
        "name": "emergency_status",
        "type": "string",
        "description": "Emergency detection result",
        "example": "Emergency"
      },
      {
        "name": "anomaly_score",
        "type": "float",
        "description": "Anomaly detection score",
        "example": "-0.85"
      },
      {
        "name": "emergency_probability",
        "type": "float",
        "description": "Emergency probability (0-1)",
        "example": "0.92"
      },
      {
        "name": "anomaly_type",
        "type": "string",
        "description": "Type of anomaly detected",
        "example": "Sudden_Stop"
      }
    ]
  },
  "spill_detections": {
    "description": "Oil and chemical spill detection from image analysis",
    "columns": [
      {
        "name": "timestamp",
        "type": "datetime",
        "description": "Detection timestamp",
        "example": "2024-01-15T10:30:00"
      },
      {
        "name": "location_id",
        "type": "string",
        "description": "Unique location identifier",
        "example": "LOC001"
      },
      {
        "name": "location_name",
