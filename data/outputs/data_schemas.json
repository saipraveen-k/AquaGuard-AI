      {
        "name": "confidence_score",
        "type": "float",
        "description": "Detection confidence (0-1)",
        "example": "0.89"
      },
      {
        "name": "source_type",
        "type": "string",
        "description": "Likely spill source",
        "example": "ship"
      },
      {
        "name": "estimated_volume_liters",
        "type": "integer",
        "description": "Estimated spill volume",
        "example": "5000"
      }
    ]
  },
  "alerts": {
    "description": "System alerts generated from all detection modules",
    "columns": [
      {
        "name": "alert_id",
        "type": "string",
        "description": "Unique alert identifier",
        "example": "ALT-001"
      },
      {
        "name": "timestamp",
        "type": "datetime",
        "description": "Alert generation time",
        "example": "2024-01-15T10:30:00"
      },
      {
        "name": "alert_type",
