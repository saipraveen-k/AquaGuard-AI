      },
      {
        "name": "latitude",
        "type": "float",
        "description": "Spill location latitude",
        "example": "40.7128"
      },
      {
        "name": "longitude",
        "type": "float",
        "description": "Spill location longitude",
        "example": "-74.0060"
      },
      {
        "name": "spill_detected",
        "type": "boolean",
        "description": "Whether spill was detected",
        "example": "True"
      },
      {
        "name": "spill_type",
        "type": "string",
