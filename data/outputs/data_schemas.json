        "example": "Flood Risk Alert - Station A"
      },
      {
        "name": "message",
        "type": "string",
        "description": "Detailed alert message",
        "example": "Flood risk 85%. Expected flooding in 4.5 hours."
      },
      {
        "name": "status",
        "type": "string",
        "description": "Alert status",
        "example": "active"
      },
      {
        "name": "latitude",
        "type": "float",
        "description": "Alert location latitude",
        "example": "40.7128"
      },
      {
        "name": "longitude",
        "type": "float",
        "description": "Alert location longitude",
        "example": "-74.0060"
      },
      {
        "name": "location_name",
        "type": "string",
        "description": "Alert location name",
        "example": "River Delta"
      },
      {
        "name": "actions_required",
        "type": "integer",
        "description": "Number of recommended actions",
        "example": "3"
      },
      {
        "name": "priority_score",
        "type": "integer",
        "description": "Priority for sorting (1=highest)",
        "example": "2"
      }
    ]
  },
  "digital_twin": {
    "description": "Digital twin simulation state and predictions",
    "columns": [
      {
        "name": "timestamp",
